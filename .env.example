# ─── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://agrotabilms.com.br

# ─── Supabase ────────────────────────────────────────────────────────────────
# A service role key ignora RLS e enxerga todos os dados de clientes.
# NUNCA prefixe com NEXT_PUBLIC_ e nunca comite o valor real.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Asaas (cobrança recorrente) ─────────────────────────────────────────────
# "sandbox" (padrão) ou "producao"
ASAAS_AMBIENTE=sandbox
ASAAS_API_KEY=
# Token que o Asaas envia no header asaas-access-token de cada webhook.
# Gere uma string aleatória longa e configure a mesma no painel do Asaas.
ASAAS_WEBHOOK_TOKEN=

# Sem ASAAS_API_KEY em desenvolvimento, o checkout usa um gateway simulado
# e nenhuma cobrança real é criada. Em produção a ausência da chave é erro.
